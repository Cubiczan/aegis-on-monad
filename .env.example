# Copy to .env and fill in. Never commit the real .env.

# Zerion v1 API key — enables live wallet portfolio import (Treasury tab)
# and live-NAV-derived CHP caps. Without it the demo runs in mirror mode.
# Get a key: https://dev.zerion.io  (sent as Authorization: Basic base64(key:))
ZERION_API_KEY=

# Prisma placeholder (not used by the demo engine)
DATABASE_URL=file:./db/custom.db
